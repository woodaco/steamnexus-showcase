@{
    var status = ViewData["StatusCode"] as int? ?? 404;
    var isNotFound = status == 404;
    ViewData["Title"] = isNotFound ? "Page not found" : status == 403 ? "Not allowed" : "Something went wrong";
}

<link rel="stylesheet" href="~/css/status-page.css" asp-append-version="true" />

<section class="sn-status-page" aria-labelledby="status-heading">
    <div class="sn-status-code" aria-hidden="true">@status</div>
    @if (isNotFound)
    {
        <h1 id="status-heading">Page not found</h1>
        <p>That address doesn't match anything on SteamNexus. It may have been mistyped, or the page may have moved.</p>
    }
    else if (status == 403 && SteamProject.Demo.DemoMode.IsDemoSession(User))
    {
        <h1 id="status-heading">Not available in the demo</h1>
        <p>The demo persona is read only, so this page or action is turned off. The Dashboard, Library and Compete pages are open to browse.</p>
    }
    else if (status == 403)
    {
        <h1 id="status-heading">Not allowed</h1>
        <p>Your account doesn't have access to this page or action.</p>
    }
    else
    {
        <h1 id="status-heading">Something went wrong</h1>
        <p>The request couldn't be completed (status @status). Please try again in a moment.</p>
    }
    <div class="sn-status-actions">
        <a class="sn-status-btn" asp-controller="Home" asp-action="Index">Back to the home page</a>
    </div>
</section>
