@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<head>
    <link rel="stylesheet" type="text/css" href="~/css/Identity.css" asp-append-version="true">
</head>

<h3>@ViewData["Title"]</h3>

<div class="identity-card">
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        Your account contains personal data that you have given us. This page allows you to download or delete that data.
    </div>

    <div class="d-flex flex-column gap-3">
        <div>
            <h4>Download Your Data</h4>
            <p class="text-muted mb-3">Download a copy of all personal data associated with your account.</p>
            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-download me-2"></i>Download
                </button>
            </form>
        </div>

        <hr />

        <div>
            <h4 class="text-danger">Delete Your Data</h4>
            <p class="text-muted mb-3">Deleting your data will permanently remove your account and all associated information. This action cannot be undone.</p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">
                <i class="bi bi-trash me-2"></i>Delete Account
            </a>
        </div>
    </div>
</div>
