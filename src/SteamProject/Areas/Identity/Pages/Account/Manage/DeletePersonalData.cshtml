@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<head>
    <link rel="stylesheet" type="text/css" href="~/css/Identity.css" asp-append-version="true">
</head>

<h3>@ViewData["Title"]</h3>

<div class="identity-card">
    <div class="alert alert-danger mb-4">
        <strong><i class="bi bi-exclamation-triangle me-2"></i>Warning!</strong>
        <p class="mb-0 mt-2">Deleting this data will permanently remove your account, and this cannot be recovered.</p>
    </div>

    <form id="delete-user" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        @if (Model.RequirePassword)
        {
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Password" />
                <label asp-for="Input.Password" class="form-label"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        }

        <button class="btn btn-lg btn-danger" type="submit">
            <i class="bi bi-trash me-2"></i>Delete data and close my account
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
